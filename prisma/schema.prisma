generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingType {
  GADGET
  CAR
  LAND
}

enum ListingStatus {
  AVAILABLE
  SOLD
  RESERVED
  HIDDEN
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String?
  type        ListingType
  price       Decimal       @db.Decimal(15, 2)
  location    String
  condition   String?
  status      ListingStatus @default(AVAILABLE)
  featured    Boolean       @default(false)
  quantity    Int           @default(1)

  // Gadget details
  brand       String?
  model       String?
  storage     String?

  // Car details
  year        Int?
  mileage     Int?
  transmission String?
  fuelType    String?

  // Property details
  propertySize String?
  titleDocument String?

  images      ListingImage[]
  enquiries   Enquiry[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  message   String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
